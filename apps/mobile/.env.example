# URL PUBLICA: nunca poner credenciales ni URL de PostgreSQL.
# Telefono fisico: sustituir por IP LAN del equipo que ejecuta la API.
# Emulador Android: http://10.0.2.2:4000
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# Clave PUBLICA hex de confianza emitida por npm run keys:generate (nunca la privada).
EXPO_PUBLIC_OFFLINE_PUBLIC_KEY=

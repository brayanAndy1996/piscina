{
  "expo": {
    "name": "Academia de natación",
    "slug": "piscina",
    "version": "0.4.0",
    "orientation": "portrait",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.piscina.academia",
      "allowBackup": false
    },
    "plugins": [
      ["expo-sqlite", {"useSQLCipher": true}],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite leer el carnet QR del alumno.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite adjuntar identificación y comprobantes privados.",
          "cameraPermission": "Permite fotografiar identificación y comprobantes.",
          "microphonePermission": false
        }
      ]
    ]
  }
}

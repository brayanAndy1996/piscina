// Esquema de AquaGestión. Las tablas y columnas del negocio van en español y en snake_case (@@map y @map).
//
// Seguridad por academia (spec 001, D-23): toda tabla del negocio lleva `academia_id` (uuid, NOT NULL, llave foránea
// a academias(id) sin borrado en cascada, UNIQUE (academia_id, id)), tiene RLS activada y forzada, y políticas que
// comparan `academia_id` con app_academia_actual(). Prisma no conoce las políticas, los CHECK ni las funciones:
// van siempre a mano en el SQL de la migración (no se pierden con `migrate dev`, pero tampoco se generan).
// Las tablas de la plataforma (academias, superadmins, auditoria_plataforma) no llevan `academia_id`.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum EstadoAcademia {
  ACTIVA
  SUSPENDIDA

  @@map("estado_academia")
}

enum TipoActor {
  USUARIO
  SUPERADMIN
  SISTEMA
  PUBLICO

  @@map("tipo_actor")
}

enum RolUsuario {
  ADMIN
  SECRETARIA
  ENTRENADOR
  ALUMNO

  @@map("rol_usuario")
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO

  @@map("estado_usuario")
}

enum NivelNatacion {
  BASICO
  INTERMEDIO
  AVANZADO

  @@map("nivel_natacion")
}

/// Una academia de natación (D-23). Nombre corto único: va en la dirección de sus páginas públicas (D-27).
model Academia {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre           String
  nombreCorto      String         @unique @map("nombre_corto")
  estado           EstadoAcademia @default(ACTIVA)
  motivoSuspension String?        @map("motivo_suspension")
  suspendidaEn     DateTime?      @map("suspendida_en") @db.Timestamptz(3)
  creadaEn         DateTime       @default(now()) @map("creada_en") @db.Timestamptz(3)
  actualizadaEn    DateTime       @default(now()) @map("actualizada_en") @db.Timestamptz(3)

  auditoria       Auditoria[]
  configuraciones Configuracion[]
  usuarios        Usuario[]
  planes          Plan[]
  clases          Clase[]
  alumnos         Alumno[]
  apoderados      Apoderado[]
  fichasMedicas   FichaMedica[]
  consentimientos Consentimiento[]
  solicitudes     SolicitudInscripcion[]
  matriculas      Matricula[]
  matriculaClases MatriculaClase[]
  cajas           Caja[]
  movimientosCaja MovimientoCaja[]
  cierresCaja     CierreCaja[]
  pagos           Pago[]
  asistencias     Asistencia[]
  inasistencias   Inasistencia[]

  @@map("academias")
}

/// El dueño de AquaGestión (D-29). No pertenece a ninguna academia.
model Superadmin {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correo           String    @unique
  nombre           String
  claveHash        String    @map("clave_hash")
  versionToken     Int       @default(0) @map("version_token")
  intentosFallidos Int       @default(0) @map("intentos_fallidos")
  bloqueadoHasta   DateTime? @map("bloqueado_hasta") @db.Timestamptz(3)
  ultimoAcceso     DateTime? @map("ultimo_acceso") @db.Timestamptz(3)
  creadoEn         DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn    DateTime  @default(now()) @map("actualizado_en") @db.Timestamptz(3)

  @@map("superadmins")
}

/// Bitácora de una academia: quién, cuándo y qué (RN-22, RNF-06). Solo se agrega: nunca se modifica ni se borra.
model Auditoria {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academiaId   String    @map("academia_id") @db.Uuid
  fechaHora    DateTime  @map("fecha_hora") @db.Timestamptz(3)
  actorTipo    TipoActor @map("actor_tipo")
  actorId      String?   @map("actor_id") @db.Uuid
  accion       String
  entidad      String
  entidadId    String?   @map("entidad_id")
  datosAntes   Json?     @map("datos_antes")
  datosDespues Json?     @map("datos_despues")
  motivo       String?
  ip           String?   @db.Inet

  academia Academia @relation(fields: [academiaId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([academiaId, id])
  @@index([academiaId, fechaHora(sort: Desc)])
  @@map("auditoria")
}

/// Bitácora de la plataforma (acciones del Superadmin y del sistema que no pertenecen a una academia).
model AuditoriaPlataforma {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fechaHora    DateTime  @map("fecha_hora") @db.Timestamptz(3)
  actorTipo    TipoActor @map("actor_tipo")
  actorId      String?   @map("actor_id") @db.Uuid
  accion       String
  entidad      String
  entidadId    String?   @map("entidad_id")
  datosAntes   Json?     @map("datos_antes")
  datosDespues Json?     @map("datos_despues")
  motivo       String?
  ip           String?   @db.Inet

  @@index([fechaHora(sort: Desc)])
  @@map("auditoria_plataforma")
}

/// Configuración clave/valor de cada academia (D-07). Sin claves en 001; las define 003.
model Configuracion {
  academiaId    String   @map("academia_id") @db.Uuid
  clave         String
  valor         Json
  actualizadoEn DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(3)

  academia Academia @relation(fields: [academiaId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([academiaId, clave])
  @@map("configuraciones")
}

/// Una cuenta de una academia (D-17, D-28): el personal (administrador, secretaria, entrenador) y los alumnos. El usuario es el
/// DNI, único dentro de cada academia. La contraseña inicial es el DNI y debe cambiarse en el primer ingreso (RN-02).
/// El rol de la API no puede cambiar el DNI, el rol, los nombres ni la academia, ni borrar filas (spec 002, criterio 2).
model Usuario {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academiaId       String        @map("academia_id") @db.Uuid
  dni              String
  nombres          String
  apellidos        String
  rol              RolUsuario
  claveHash        String        @map("clave_hash")
  debeCambiarClave Boolean       @default(true) @map("debe_cambiar_clave")
  estado           EstadoUsuario @default(ACTIVO)
  versionToken     Int           @default(0) @map("version_token")
  intentosFallidos Int           @default(0) @map("intentos_fallidos")
  bloqueadoHasta   DateTime?     @map("bloqueado_hasta") @db.Timestamptz(3)
  ultimoAcceso     DateTime?     @map("ultimo_acceso") @db.Timestamptz(3)
  creadoEn         DateTime      @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn    DateTime      @default(now()) @map("actualizado_en") @db.Timestamptz(3)

  academia               Academia               @relation(fields: [academiaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  clases                 Clase[]
  alumnos                Alumno[]
  cajasAbiertas          Caja[]                 @relation("CajaAbiertaPor")
  movimientosCaja        MovimientoCaja[]
  cierresCerrados        CierreCaja[]           @relation("CierreCerradoPor")
  cierresReabiertos      CierreCaja[]           @relation("CierreReabiertoPor")
  pagosRegistrados       Pago[]                 @relation("PagoRegistradoPor")
  pagosVerificados       Pago[]                 @relation("PagoVerificadoPor")
  asistenciasRegistradas Asistencia[]           @relation("AsistenciaRegistradaPor")
  solicitudesRegistradas SolicitudInscripcion[] @relation("SolicitudRegistradaPor")

  @@unique([academiaId, id])
  @@unique([academiaId, dni])
  @@index([academiaId, rol, apellidos, nombres])
  @@map("usuarios")
}

/// Un plan de la academia (HU-19, RN-07). El precio ya incluye IGV (D-03) y es la base del cobro proporcional (RN-25). Los arreglos
/// (días, franjas y niveles) viven en la misma fila. El nombre es único en la academia sin distinguir mayúsculas (índice sobre
/// `lower(nombre)` a mano en la migración, que Prisma no representa), y los CHECK de los criterios 4 y 33 también van a mano. No se borra: se
/// desactiva (spec 004).
model Plan {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academiaId        String          @map("academia_id") @db.Uuid
  nombre            String
  vecesPorSemana    Int             @map("veces_por_semana") @db.SmallInt
  clasesPorMes      Int             @map("clases_por_mes") @db.SmallInt
  duracionMinutos   Int             @default(60) @map("duracion_minutos") @db.SmallInt
  precio            Decimal         @db.Decimal(10, 2)
  diasPermitidos    Int[]           @map("dias_permitidos") @db.SmallInt
  franjasPermitidas DateTime[]      @map("franjas_permitidas") @db.Time(0)
  nivelesAplicables NivelNatacion[] @map("niveles_aplicables")
  vigenciaInicio    DateTime?       @map("vigencia_inicio") @db.Date
  vigenciaFin       DateTime?       @map("vigencia_fin") @db.Date
  activo            Boolean         @default(true)
  creadoEn          DateTime        @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn     DateTime        @default(now()) @map("actualizado_en") @db.Timestamptz(3)

  academia   Academia    @relation(fields: [academiaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  matriculas Matricula[]

  @@unique([academiaId, id])
  @@map("planes")
}

/// Una clase de la semana (HU-17, RN-09 a RN-11): nivel, día, bloque de 1 hora (horas locales de Lima, sin zona), entrenador y aforo
/// de 20 a 50. Los índices únicos parciales del bloque (`WHERE activo`) y los CHECK van a mano en la migración. El rol de la API no
/// cambia el nivel, el día ni la hora, y no borra filas: una clase se desactiva (spec 004). Es el lugar donde las historias siguientes
/// bloquean el cupo (`bloquearClasesParaCupo`).
model Clase {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academiaId    String        @map("academia_id") @db.Uuid
  nivel         NivelNatacion
  diaSemana     Int           @map("dia_semana") @db.SmallInt
  horaInicio    DateTime      @map("hora_inicio") @db.Time(0)
  horaFin       DateTime      @map("hora_fin") @db.Time(0)
  entrenadorId  String        @map("entrenador_id") @db.Uuid
  aforo         Int           @db.SmallInt
  activo        Boolean       @default(true)
  creadoEn      DateTime      @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime      @default(now()) @map("actualizado_en") @db.Timestamptz(3)

  academia        Academia         @relation(fields: [academiaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  entrenador      Usuario          @relation(fields: [academiaId, entrenadorId], references: [academiaId, id], onDelete: Restrict, onUpdate: Restrict)
  matriculaClases MatriculaClase[]
  asistencias     Asistencia[]
  inasistencias   Inasistencia[]

  @@unique([academiaId, id])
  @@index([academiaId, diaSemana, horaInicio])
  @@map("clases")
}

// ---------------------------------------------------------------------------------------------------------------------------------
// Historia 005a · Inscripción pública, reserva y seguimiento (D-05, D-07, D-23, D-28). Las políticas de RLS, los CHECK, los índices
// parciales y los privilegios van a mano en la migración `inscripcion_publica`; Prisma no los conoce.
// ---------------------------------------------------------------------------------------------------------------------------------

/// Sección 8.8 de los requerimientos. La 005 solo escribe `CLIENTE`; la 007 suma las transiciones.
enum EstadoAlumno {
  CLIENTE
  ALUMNO_ACTIVO
  ALUMNO_VENCIDO
  INACTIVO

  @@map("estado_alumno")
}

/// `CONFIRMADA` (007): el pago se confirmó y la persona pasó a alumno. `EN_VERIFICACION` y `PAGO_RECHAZADO` se calculan al leer con el último pago.
enum EstadoSolicitud {
  PENDIENTE_PAGO
  VENCIDA
  CANCELADA
  CONFIRMADA

  @@map("estado_solicitud")
}

enum EstadoMatricula {
  RESERVADA
  VIGENTE
  FINALIZADA
  CANCELADA

  @@map("estado_matricula")
}

enum TipoConsentimiento {
  DATOS_PERSONALES
  DESLINDE
  IMAGEN

  @@map("tipo_consentimiento")
}

enum OtorganteConsentimiento {
  TITULAR
  APODERADO

  @@map("otorgante_consentimiento")
}

enum TipoSangre {
  A_POSITIVO
  A_NEGATIVO
  B_POSITIVO
  B_NEGATIVO
  AB_POSITIVO
  AB_NEGATIVO
  O_POSITIVO
  O_NEGATIVO
  NO_SABE

  @@map("tipo_sangre")
}

enum GradoColegio {
  INICIAL
  PRIMARIA_1
  PRIMARIA_2
  PRIMARIA_3
  PRIMARIA_4
  PRIMARIA_5
  PRIMARIA_6
  SECUNDARIA_1
  SECUNDARIA_2
  SECUNDARIA_3
  SECUNDARIA_4
  SECUNDARIA_5
  NO_ESTUDIA

  @@map("grado_colegio")
}

enum Parentesco {
  PADRE
  MADRE
  OTRO_APODERADO

  @@map("parentesco")
}

/// La persona que se inscribe (RN-01: es cliente hasta que su primer pago se confirme). El DNI es único por academia (D-28). El rol de la
/// API no cambia el DNI, el estado ni la academia, y no borra filas. `fotoClave` es la clave del archivo en `AlmacenArchivos` (005b).
model Alumno {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academiaId          String        @map("academia_id") @db.Uuid
  dni                 String
  nombres             String
  apellidos           String
  fechaNacimiento     DateTime      @map("fecha_nacimiento") @db.Date
  telefono            String
  correo              String?
  direccion           String?
  gradoColegio        GradoColegio? @map("grado_colegio")
  nivel               NivelNatacion
  fotoClave           String?       @map("foto_clave")
  estado              EstadoAlumno  @default(CLIENTE)
  usuarioId           String?       @map("usuario_id") @db.Uuid
  /// Token aleatorio del QR del carnet (008a, RN-06): 32 bytes en base64url. Solo con el pago confirmado; los CHECK de la migración lo garantizan.
  qrToken             String?       @map("qr_token")
  qrGeneradoEn        DateTime?     @map("qr_generado_en") @db.Timestamptz(3)
  /// Clave de la última regeneración del QR (DT-7): un reintento con la misma clave no cambia el token.
  qrClaveIdempotencia String?       @map("qr_clave_idempotencia") @db.Uuid
  creadoEn            DateTime      @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn       DateTime      @default(now()) @map("actualizado_en") @db.Timestamptz(3)

  academia        Academia               @relation(fields: [academiaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  usuario         Usuario?               @relation(fields: [academiaId, usuarioId], references: [academiaId, id], onDelete: Restrict, onUpdate: Restrict)
  apoderados      Apoderado[]
  fichasMedicas   FichaMedica[]
  consentimientos Consentimiento[]
  solicitudes     SolicitudInscripcion[]
  matriculas      Matricula[]
  movimientosCaja MovimientoCaja[]
  pagos           Pago[]
  asistencias     Asistencia[]
  inasistencias   Inasistencia[]

  @@unique([academiaId, id])
  @@unique([academiaId, dni])
  @@unique([academiaId, qrToken])
  @@index([academiaId, estado])
  @@map("alumnos")
}

/// Un apoderado por alumno (D9 de 005). Es la única tabla de la 005 de la que el rol de la API puede borrar filas.
model Apoderado {
  alumnoId      String     @map("alumno_id") @db.Uuid
  academiaId    String     @map("academia_id") @db.Uuid
  nombres       String
  apellidos     String
  dni           String
  telefono      String
  parentesco    Parentesco
  correo        String?
  creadoEn      DateTime   @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime   @default(now()) @map("actualizado_en") @db.Timestamptz(3)

  academia Academia @relation(fields: [academiaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  alumno   Alumno   @relation(fields: [academiaId, alumnoId], references: [academiaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([academiaId, alumnoId])
  @@map("apoderados")
}

/// Datos de salud: sensibles (Ley 29733, RN-21). Una ficha por alumno.
model FichaMedica {
  alumnoId                   String     @map("alumno_id") @db.Uuid
  academiaId                 String     @map("academia_id") @db.Uuid
  tipoSangre                 TipoSangre @map("tipo_sangre")
  enfermedades               String?
  alergias                   String?
  medicamentos               String?
  seguro                     String?
  contactoEmergenciaNombre   String     @map("contacto_emergencia_nombre")
  contactoEmergenciaTelefono String     @map("contacto_emergencia_telefono")
  creadoEn                   DateTime   @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn              DateTime   @default(now()) @map("actualizado_en") @db.Timestamptz(3)

  academia Academia @relation(fields: [academiaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  alumno   Alumno   @relation(fields: [academiaId, alumnoId], references: [academiaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([academiaId, alumnoId])
  @@map("fichas_medicas")
}

/// Evidencia de los consentimientos (D-07, RNF-05): solo se agrega, nunca se modifica ni se borra.
model Consentimiento {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academiaId  String                  @map("academia_id") @db.Uuid
  alumnoId    String                  @map("alumno_id") @db.Uuid
  solicitudId String                  @map("solicitud_id") @db.Uuid
  tipo        TipoConsentimiento
  version     String
  aceptadoEn  DateTime                @map("aceptado_en") @db.Timestamptz(3)
  ip          String?                 @db.Inet
  otorgadoPor OtorganteConsentimiento @map("otorgado_por")
  aceptado    Boolean

  academia  Academia             @relation(fields: [academiaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  alumno    Alumno               @relation(fields: [academiaId, alumnoId], references: [academiaId, id], onDelete: Restrict, onUpdate: Restrict)
  solicitud SolicitudInscripcion @relation(fields: [academiaId, solicitudId], references: [academiaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([academiaId, id])
  @@index([academiaId, solicitudId])
  @@map("consentimientos")
}

/// La solicitud que sigue la persona con su código y su enlace (D-05, D-07). Del token solo se guarda su SHA-256 (`tokenHash`). El rol
/// de la API solo cambia el estado.
model SolicitudInscripcion {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academiaId        String          @map("academia_id") @db.Uuid
  alumnoId          String          @map("alumno_id") @db.Uuid
  codigo            String
  tokenHash         Bytes           @map("token_hash")
  claveIdempotencia String          @map("clave_idempotencia") @db.Uuid
  estado            EstadoSolicitud @default(PENDIENTE_PAGO)
  ipOrigen          String?         @map("ip_origen") @db.Inet
  /// Quién inscribió a la persona desde recepción (007, criterio 34); `null` si se inscribió sola. Solo se escribe al insertar.
  registradaPorId   String?         @map("registrada_por") @db.Uuid
  creadoEn          DateTime        @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn     DateTime        @default(now()) @map("actualizado_en") @db.Timestamptz(3)

  academia        Academia         @relation(fields: [academiaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  alumno          Alumno           @relation(fields: [academiaId, alumnoId], references: [academiaId, id], onDelete: Restrict, onUpdate: Restrict)
  registradaPor   Usuario?         @relation("SolicitudRegistradaPor", fields: [academiaId, registradaPorId], references: [academiaId, id], onDelete: Restrict, onUpdate: Restrict)
  consentimientos Consentimiento[]
  matriculas      Matricula[]

  @@unique([academiaId, id])
  @@unique([academiaId, codigo])
  @@unique([academiaId, tokenHash])
  @@unique([academiaId, claveIdempotencia])
  @@index([academiaId, alumnoId])
  @@index([academiaId, ipOrigen, estado])
  @@map("solicitudes_inscripcion")
}

/// La mensualidad de un alumno en un mes (RN-27). La reserva de la 005 es una matrícula `RESERVADA` con vencimiento (D1 de 005). Guarda su
/// propio precio y clases: un cambio del plan no la afecta (HU-19). El índice único parcial de la matrícula que ocupa cupo va a mano.
model Matricula {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academiaId       String          @map("academia_id") @db.Uuid
  alumnoId         String          @map("alumno_id") @db.Uuid
  planId           String          @map("plan_id") @db.Uuid
  solicitudId      String?         @map("solicitud_id") @db.Uuid
  anio             Int             @db.SmallInt
  mes              Int             @db.SmallInt
  fechaInicio      DateTime        @map("fecha_inicio") @db.Date
  fechaFin         DateTime        @map("fecha_fin") @db.Date
  clasesTotales    Int             @map("clases_totales") @db.SmallInt
  clasesUsadas     Int             @default(0) @map("clases_usadas") @db.SmallInt
  esProporcional   Boolean         @map("es_proporcional")
  precioPlan       Decimal         @map("precio_plan") @db.Decimal(10, 2)
  clasesPorMesPlan Int             @map("clases_por_mes_plan") @db.SmallInt
  montoCalculado   Decimal         @map("monto_calculado") @db.Decimal(10, 2)
  montoAjustado    Decimal?        @map("monto_ajustado") @db.Decimal(10, 2)
  motivoAjuste     String?         @map("motivo_ajuste")
  estado           EstadoMatricula
  reservaVenceEn   DateTime?       @map("reserva_vence_en") @db.Timestamptz(3)
  creadoEn         DateTime        @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn    DateTime        @default(now()) @map("actualizado_en") @db.Timestamptz(3)

  academia      Academia              @relation(fields: [academiaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  alumno        Alumno                @relation(fields: [academiaId, alumnoId], references: [academiaId, id], onDelete: Restrict, onUpdate: Restrict)
  plan          Plan                  @relation(fields: [academiaId, planId], references: [academiaId, id], onDelete: Restrict, onUpdate: Restrict)
  solicitud     SolicitudInscripcion? @relation(fields: [academiaId, solicitudId], references: [academiaId, id], onDelete: Restrict, onUpdate: Restrict)
  clases        MatriculaClase[]
  pagos         Pago[]
  asistencias   Asistencia[]
  inasistencias Inasistencia[]

  @@unique([academiaId, id])
  @@unique([academiaId, id, alumnoId])
  @@index([academiaId, anio, mes, estado])
  @@index([academiaId, alumnoId])
  @@index([academiaId, solicitudId])
  @@map("matriculas")
}

/// Las clases elegidas de cada matrícula; de aquí se cuenta la ocupación de una clase.
model MatriculaClase {
  academiaId  String @map("academia_id") @db.Uuid
  matriculaId String @map("matricula_id") @db.Uuid
  claseId     String @map("clase_id") @db.Uuid

  academia  Academia  @relation(fields: [academiaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  matricula Matricula @relation(fields: [academiaId, matriculaId], references: [academiaId, id], onDelete: Restrict, onUpdate: Restrict)
  clase     Clase     @relation(fields: [academiaId, claseId], references: [academiaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([academiaId, matriculaId, claseId])
  @@index([academiaId, claseId])
  @@map("matricula_clases")
}

// ---------------------------------------------------------------------------------------------------------------------
// Historia 006a · Caja del día (D-17, D-23, D-25; HU-25 a HU-27, RN-17, RN-22). Los CHECK de los montos y de las cuentas del cierre, los
// índices únicos parciales (una caja abierta, una entrada por pago, una clave por egreso, un cierre vigente), el trigger de la caja cerrada,
// las políticas de RLS y los privilegios van a mano en la migración. La API escribe con SQL (`$queryRaw` y `$executeRaw`), no con estos
// modelos: existen para que Prisma conozca las tablas y sus llaves compuestas.
// ---------------------------------------------------------------------------------------------------------------------

enum EstadoCaja {
  ABIERTA
  CERRADA

  @@map("estado_caja")
}

enum TipoMovimientoCaja {
  INGRESO
  EGRESO

  @@map("tipo_movimiento_caja")
}

enum ConceptoMovimientoCaja {
  INSCRIPCION
  MENSUALIDAD
  CLASE_PARTICULAR
  EGRESO_MENOR

  @@map("concepto_movimiento_caja")
}

enum MetodoPago {
  EFECTIVO
  YAPE
  TRANSFERENCIA

  @@map("metodo_pago")
}

/// La caja del día de una academia: una abierta a la vez y una por día (DR-1). `fecha` es la de America/Lima de `abiertaEn`. El rol de la
/// API solo cambia el estado y `actualizadoEn`, y no borra filas (spec 006, criterio 2).
model Caja {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academiaId        String     @map("academia_id") @db.Uuid
  fecha             DateTime   @db.Date
  estado            EstadoCaja @default(ABIERTA)
  montoInicial      Decimal    @map("monto_inicial") @db.Decimal(10, 2)
  abiertaPorId      String     @map("abierta_por") @db.Uuid
  abiertaEn         DateTime   @map("abierta_en") @db.Timestamptz(3)
  claveIdempotencia String     @map("clave_idempotencia") @db.Uuid
  creadoEn          DateTime   @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn     DateTime   @default(now()) @map("actualizado_en") @db.Timestamptz(3)

  academia    Academia         @relation(fields: [academiaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  abiertaPor  Usuario          @relation("CajaAbiertaPor", fields: [academiaId, abiertaPorId], references: [academiaId, id], onDelete: Restrict, onUpdate: Restrict)
  movimientos MovimientoCaja[]
  cierres     CierreCaja[]

  @@unique([academiaId, id])
  @@unique([academiaId, claveIdempotencia])
  @@unique([academiaId, fecha])
  @@map("cajas")
}

/// Un ingreso (de un cobro, 007) o un egreso menor (en efectivo) de la caja. No cambia ni se borra (DR-5). `pagoId` tiene la llave compuesta
/// hacia `pagos` (007), diferida: el pago en efectivo se inserta después de su movimiento. Los índices únicos parciales por `pago_id` y por `clave_idempotencia` y el trigger de la caja cerrada van a mano.
model MovimientoCaja {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academiaId        String                 @map("academia_id") @db.Uuid
  cajaId            String                 @map("caja_id") @db.Uuid
  numero            Int
  tipo              TipoMovimientoCaja
  concepto          ConceptoMovimientoCaja
  metodo            MetodoPago
  monto             Decimal                @db.Decimal(10, 2)
  descripcion       String?
  comprobante       String?
  alumnoId          String?                @map("alumno_id") @db.Uuid
  pagoId            String?                @map("pago_id") @db.Uuid
  registradoPorId   String                 @map("registrado_por") @db.Uuid
  registradoEn      DateTime               @map("registrado_en") @db.Timestamptz(3)
  claveIdempotencia String?                @map("clave_idempotencia") @db.Uuid

  academia      Academia @relation(fields: [academiaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  caja          Caja     @relation(fields: [academiaId, cajaId], references: [academiaId, id], onDelete: Restrict, onUpdate: Restrict)
  alumno        Alumno?  @relation(fields: [academiaId, alumnoId], references: [academiaId, id], onDelete: Restrict, onUpdate: Restrict)
  registradoPor Usuario  @relation(fields: [academiaId, registradoPorId], references: [academiaId, id], onDelete: Restrict, onUpdate: Restrict)
  pago          Pago?    @relation(fields: [academiaId, pagoId], references: [academiaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([academiaId, id])
  @@unique([academiaId, cajaId, numero])
  @@map("movimientos_caja")
}

/// Cada cierre de una caja: la foto de lo calculado al cerrar (D1). Solo cambia para registrar su reapertura (quién, cuándo y el motivo).
/// Los CHECK de las cuentas y el índice único parcial del cierre vigente van a mano.
model CierreCaja {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academiaId            String    @map("academia_id") @db.Uuid
  cajaId                String    @map("caja_id") @db.Uuid
  numero                Int       @db.SmallInt
  movimientosHasta      Int       @map("movimientos_hasta")
  montoInicial          Decimal   @map("monto_inicial") @db.Decimal(12, 2)
  ingresosEfectivo      Decimal   @map("ingresos_efectivo") @db.Decimal(12, 2)
  ingresosYape          Decimal   @map("ingresos_yape") @db.Decimal(12, 2)
  ingresosTransferencia Decimal   @map("ingresos_transferencia") @db.Decimal(12, 2)
  egresosEfectivo       Decimal   @map("egresos_efectivo") @db.Decimal(12, 2)
  esperadoEfectivo      Decimal   @map("esperado_efectivo") @db.Decimal(12, 2)
  montoDeclarado        Decimal   @map("monto_declarado") @db.Decimal(12, 2)
  diferencia            Decimal   @db.Decimal(12, 2)
  observacion           String?
  tardio                Boolean
  cerradoPorId          String    @map("cerrado_por") @db.Uuid
  cerradoEn             DateTime  @map("cerrado_en") @db.Timestamptz(3)
  claveIdempotencia     String    @map("clave_idempotencia") @db.Uuid
  reabiertoPorId        String?   @map("reabierto_por") @db.Uuid
  reabiertoEn           DateTime? @map("reabierto_en") @db.Timestamptz(3)
  motivoReapertura      String?   @map("motivo_reapertura")
  creadoEn              DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)

  academia     Academia @relation(fields: [academiaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  caja         Caja     @relation(fields: [academiaId, cajaId], references: [academiaId, id], onDelete: Restrict, onUpdate: Restrict)
  cerradoPor   Usuario  @relation("CierreCerradoPor", fields: [academiaId, cerradoPorId], references: [academiaId, id], onDelete: Restrict, onUpdate: Restrict)
  reabiertoPor Usuario? @relation("CierreReabiertoPor", fields: [academiaId, reabiertoPorId], references: [academiaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([academiaId, id])
  @@unique([academiaId, cajaId, numero])
  @@unique([academiaId, claveIdempotencia])
  @@map("cierres_caja")
}

// ---------------------------------------------------------------------------------------------------------------------
// Historia 007a · Pagos (D-04, D-07, D-23; HU-04, HU-07 a HU-09, RN-01, RN-04, RN-17). Los CHECK, los índices parciales, los triggers (la
// transición única y «confirmado ⇔ su movimiento de caja»), las políticas de RLS y los privilegios van a mano en la migración `pagos`. La API
// escribe con SQL (`$queryRaw` y `$executeRaw`): el modelo existe para que Prisma conozca la tabla y sus llaves compuestas.
// ---------------------------------------------------------------------------------------------------------------------

enum EstadoPago {
  PENDIENTE_VERIFICACION
  CONFIRMADO
  RECHAZADO

  @@map("estado_pago")
}

/// El pago de una matrícula. Un pago resuelto (`CONFIRMADO` o `RECHAZADO`) no cambia nunca. Un confirmado tiene exactamente un movimiento de caja
/// con su `pago_id`. `numeroOperacion` es lo que escribió la persona y `numeroOperacionNormalizado` su forma comparable (D-07, DT-9).
model Pago {
  id                         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academiaId                 String                 @map("academia_id") @db.Uuid
  alumnoId                   String                 @map("alumno_id") @db.Uuid
  matriculaId                String                 @map("matricula_id") @db.Uuid
  concepto                   ConceptoMovimientoCaja
  metodo                     MetodoPago
  estado                     EstadoPago
  monto                      Decimal                @db.Decimal(10, 2)
  numeroOperacion            String?                @map("numero_operacion")
  numeroOperacionNormalizado String?                @map("numero_operacion_normalizado")
  fechaOperacion             DateTime?              @map("fecha_operacion") @db.Date
  comprobanteClave           String?                @map("comprobante_clave")
  ipOrigen                   String?                @map("ip_origen") @db.Inet
  registradoPorId            String?                @map("registrado_por") @db.Uuid
  verificadoPorId            String?                @map("verificado_por") @db.Uuid
  registradoEn               DateTime               @map("registrado_en") @db.Timestamptz(3)
  verificadoEn               DateTime?              @map("verificado_en") @db.Timestamptz(3)
  motivoRechazo              String?                @map("motivo_rechazo")
  numeroTicket               Int?                   @map("numero_ticket")
  claveIdempotencia          String                 @map("clave_idempotencia") @db.Uuid
  creadoEn                   DateTime               @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn              DateTime               @default(now()) @map("actualizado_en") @db.Timestamptz(3)

  academia        Academia         @relation(fields: [academiaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  alumno          Alumno           @relation(fields: [academiaId, alumnoId], references: [academiaId, id], onDelete: Restrict, onUpdate: Restrict)
  matricula       Matricula        @relation(fields: [academiaId, matriculaId, alumnoId], references: [academiaId, id, alumnoId], onDelete: Restrict, onUpdate: Restrict)
  registradoPor   Usuario?         @relation("PagoRegistradoPor", fields: [academiaId, registradoPorId], references: [academiaId, id], onDelete: Restrict, onUpdate: Restrict)
  verificadoPor   Usuario?         @relation("PagoVerificadoPor", fields: [academiaId, verificadoPorId], references: [academiaId, id], onDelete: Restrict, onUpdate: Restrict)
  movimientosCaja MovimientoCaja[]

  @@unique([academiaId, id])
  @@unique([academiaId, claveIdempotencia])
  @@unique([academiaId, numeroTicket])
  @@index([academiaId, estado, registradoEn])
  @@map("pagos")
}

// ---------------------------------------------------------------------------------------------------------------------
// Historia 009a · Asistencia por QR y manual (D-07, D-11, D-16, D-23; HU-14, HU-15, RN-14 a RN-16). Los tres CHECK (la fecha de Lima, el registro
// después de la llegada, el registro posterior coherente), el único parcial `asistencias_un_dia_key`, las políticas de RLS y los privilegios van a
// mano en la migración `asistencias`. La API escribe con SQL (`$queryRaw` y `$executeRaw`): el modelo existe para que Prisma conozca la tabla y
// sus llaves compuestas.
// ---------------------------------------------------------------------------------------------------------------------

enum MetodoAsistencia {
  QR
  MANUAL

  @@map("metodo_asistencia")
}

/// D-07: la 009 solo escribe `NORMAL`; los otros tres los usan las historias de recuperación (018), otro horario (020) y particulares (016).
enum TipoAsistencia {
  NORMAL
  RECUPERACION
  FUERA_HORARIO
  PARTICULAR

  @@map("tipo_asistencia")
}

/// D-11: puntual hasta la tolerancia de la academia (se compara por minuto) y tarde después.
enum EstadoLlegada {
  PUNTUAL
  TARDE

  @@map("estado_llegada")
}

/// Una asistencia: no cambia ni se borra (el rol de la API solo tiene `SELECT` e `INSERT`). Cada una descuenta una clase de la matrícula (RN-14).
/// `fecha` es la fecha de Lima de `llegadaEn`; una asistencia por alumno y día salvo las `PARTICULAR` (RN-16).
model Asistencia {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academiaId        String           @map("academia_id") @db.Uuid
  alumnoId          String           @map("alumno_id") @db.Uuid
  matriculaId       String           @map("matricula_id") @db.Uuid
  claseId           String           @map("clase_id") @db.Uuid
  fecha             DateTime         @db.Date
  llegadaEn         DateTime         @map("llegada_en") @db.Timestamptz(3)
  registradoEn      DateTime         @map("registrado_en") @db.Timestamptz(3)
  metodo            MetodoAsistencia
  tipo              TipoAsistencia   @default(NORMAL)
  estadoLlegada     EstadoLlegada    @map("estado_llegada")
  registradoPorId   String           @map("registrado_por") @db.Uuid
  registroPosterior Boolean          @default(false) @map("registro_posterior")
  motivo            String?
  claveIdempotencia String           @map("clave_idempotencia") @db.Uuid

  academia      Academia       @relation(fields: [academiaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  alumno        Alumno         @relation(fields: [academiaId, alumnoId], references: [academiaId, id], onDelete: Restrict, onUpdate: Restrict)
  matricula     Matricula      @relation(fields: [academiaId, matriculaId, alumnoId], references: [academiaId, id, alumnoId], onDelete: Restrict, onUpdate: Restrict)
  clase         Clase          @relation(fields: [academiaId, claseId], references: [academiaId, id], onDelete: Restrict, onUpdate: Restrict)
  registradoPor Usuario        @relation("AsistenciaRegistradaPor", fields: [academiaId, registradoPorId], references: [academiaId, id], onDelete: Restrict, onUpdate: Restrict)
  inasistencias Inasistencia[]

  @@unique([academiaId, id])
  @@unique([academiaId, id, alumnoId, fecha])
  @@unique([academiaId, claveIdempotencia])
  @@index([academiaId, matriculaId])
  @@index([academiaId, fecha])
  @@map("asistencias")
}

/// Una falta: la registra la tarea programada al terminar la clase de quien no marcó (D-08) y no descuenta clases (RN-14). No se borra ni se corrige: solo
/// se cubre, una vez, con la asistencia del mismo alumno y del mismo día (registro posterior de D-16): `asistenciaId` y `cubiertaEn` pasan de nulos a no nulos.
/// El rol de la API solo tiene `SELECT`, `INSERT` y `UPDATE (asistencia_id, cubierta_en)`; un trigger (`inasistencias_se_cubre_una_vez`), el CHECK
/// `inasistencias_cubierta_coherente` y las políticas de RLS van a mano en la migración.
model Inasistencia {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academiaId   String    @map("academia_id") @db.Uuid
  alumnoId     String    @map("alumno_id") @db.Uuid
  matriculaId  String    @map("matricula_id") @db.Uuid
  claseId      String    @map("clase_id") @db.Uuid
  fecha        DateTime  @db.Date
  registradaEn DateTime  @map("registrada_en") @db.Timestamptz(3)
  asistenciaId String?   @map("asistencia_id") @db.Uuid
  cubiertaEn   DateTime? @map("cubierta_en") @db.Timestamptz(3)

  academia   Academia    @relation(fields: [academiaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  alumno     Alumno      @relation(fields: [academiaId, alumnoId], references: [academiaId, id], onDelete: Restrict, onUpdate: Restrict)
  matricula  Matricula   @relation(fields: [academiaId, matriculaId, alumnoId], references: [academiaId, id, alumnoId], onDelete: Restrict, onUpdate: Restrict)
  clase      Clase       @relation(fields: [academiaId, claseId], references: [academiaId, id], onDelete: Restrict, onUpdate: Restrict)
  asistencia Asistencia? @relation(fields: [academiaId, asistenciaId, alumnoId, fecha], references: [academiaId, id, alumnoId, fecha], onDelete: Restrict, onUpdate: Restrict)

  @@unique([academiaId, id])
  @@unique([academiaId, alumnoId, claseId, fecha], map: "inasistencias_una_por_clase_key")
  @@index([academiaId, alumnoId, fecha])
  @@index([academiaId, matriculaId])
  @@map("inasistencias")
}

# Configuración local de AquaGestión. Copia este archivo a .env (en PowerShell: Copy-Item .env.example .env).
# Todos los valores son de desarrollo e inventados; funcionan tal cual con docker-compose.yml y con el
# PostgreSQL de la nube. Nunca subas tu .env al repositorio.

# Base de datos de desarrollo (Docker en la PC, PostgreSQL del contenedor en la nube).
# Se usa 127.0.0.1 y no localhost: en Windows, localhost puede resolverse a ::1 y Docker publica en IPv4.
DATABASE_URL=postgresql://aquagestion:aquagestion@127.0.0.1:5432/aquagestion

# Base de pruebas: su nombre debe terminar en _pruebas y ser distinta de la de desarrollo.
# Las pruebas de integración se niegan a correr si no cumple.
DATABASE_URL_PRUEBAS=postgresql://aquagestion:aquagestion@127.0.0.1:5432/aquagestion_pruebas

# Puerto que publica docker compose en tu PC. Cámbialo si el 5432 está ocupado,
# y cambia también el puerto en DATABASE_URL, DATABASE_URL_PRUEBAS y DATABASE_URL_APP.
POSTGRES_PUERTO=5432

# Puerto de la API (NestJS) en desarrollo.
PUERTO_API=3000

# Puerto de la web (Vite) en desarrollo. Si está ocupado, falla en lugar de cambiarlo.
PUERTO_WEB=5173

# Modo de ejecución (opcional): development muestra los registros en formato legible.
NODE_ENV=development

# Navegador para las pruebas E2E (opcional). Solo para la nube o contenedores con Chromium preinstalado;
# en Windows no se define (Playwright usa el navegador que instaló).
# CHROMIUM_EJECUTABLE=

# --- Historia 001 (academias y aislamiento) ---

# Conexión de la API: un rol sin privilegios, sujeto a la seguridad por academia (RLS). El rol se llama
# aquagestion_app y lo crea `npm run db:crear` (en la nube, el hook de sesión). No uses aquí el usuario de
# DATABASE_URL: la API se niega a atender datos si el rol es superusuario, dueño de las tablas o tiene BYPASSRLS.
DATABASE_URL_APP=postgresql://aquagestion_app:aquagestion_app@127.0.0.1:5432/aquagestion

# Conexiones simultáneas de la API a la base (opcional, de 1 a 100; por defecto 10).
# DATABASE_POOL_MAX=10

# Secreto para firmar las sesiones. SOLO DESARROLLO: en producción usa uno largo y aleatorio (al menos 32
# caracteres); con NODE_ENV=production la API rechaza este valor. Cambiarlo cierra todas las sesiones.
JWT_SECRETO=solo-desarrollo-cambia-este-secreto-de-ejemplo-0001

# Superadmin de desarrollo (el dueño de AquaGestión). Lo crea `npm run db:semilla` si está definido; en producción se
# crea o se restablece con `npm run plataforma:superadmin`. La contraseña tiene al menos 12 caracteres.
SUPERADMIN_CORREO=superadmin@aquagestion.test
SUPERADMIN_NOMBRE=Superadmin de desarrollo
SUPERADMIN_CLAVE=clave-de-desarrollo-123

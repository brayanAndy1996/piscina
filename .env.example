# Configuración local de AquaGestión. Copia este archivo a .env (en PowerShell: Copy-Item .env.example .env).
# Todos los valores son de desarrollo e inventados; funcionan tal cual con docker-compose.yml y con el
# PostgreSQL de la nube. Nunca subas tu .env al repositorio.

# Base de datos de desarrollo (Docker en la PC, PostgreSQL del contenedor en la nube).
# Se usa 127.0.0.1 y no localhost: en Windows, localhost puede resolverse a ::1 y Docker publica en IPv4.
DATABASE_URL=postgresql://aquagestion:aquagestion@127.0.0.1:5432/aquagestion

# Base de pruebas: su nombre debe terminar en _pruebas y ser distinta de la de desarrollo.
# Las pruebas de integración se niegan a correr si no cumple.
DATABASE_URL_PRUEBAS=postgresql://aquagestion:aquagestion@127.0.0.1:5432/aquagestion_pruebas

# Puerto que publica docker compose en tu PC. Cámbialo si el 5432 está ocupado,
# y cambia también el puerto en DATABASE_URL y en DATABASE_URL_PRUEBAS.
POSTGRES_PUERTO=5432

# Puerto de la API (NestJS) en desarrollo.
PUERTO_API=3000

# Puerto de la web (Vite) en desarrollo. Si está ocupado, falla en lugar de cambiarlo.
PUERTO_WEB=5173

# Modo de ejecución (opcional): development muestra los registros en formato legible.
NODE_ENV=development

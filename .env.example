# Solo servidor. Copiar a .env en la raiz; no publicar credenciales reales.
NODE_ENV=development
# Para un telefono por LAN: API_HOST=0.0.0.0 (solo red local de desarrollo).
API_HOST=127.0.0.1
API_PORT=4000
API_DATABASE_URL=postgres://piscina:piscina_local@127.0.0.1:5432/piscina_dev
# En produccion: require con certificado de servidor valido.
API_DATABASE_SSL=disable
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Usada solo por el servidor Next.js; nunca por el bundle del navegador.
API_URL=http://127.0.0.1:4000

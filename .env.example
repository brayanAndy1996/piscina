# Solo servidor. Copiar a .env en la raiz; no publicar credenciales reales.
NODE_ENV=development
# Para un telefono por LAN: API_HOST=0.0.0.0 (solo red local de desarrollo).
API_HOST=127.0.0.1
API_PORT=4000
API_DATABASE_URL=postgres://piscina:piscina_local@127.0.0.1:5432/piscina_dev
# En produccion: require con certificado de servidor valido.
API_DATABASE_SSL=disable
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Usada solo por el servidor Next.js; nunca por el bundle del navegador.
API_URL=http://127.0.0.1:4000

# Solo pruebas, BD local _test y rol dedicado con CREATEDB; no usar una BD real.
API_TEST_DATABASE_URL=
# Bootstrap/recuperacion explicitos. Completar password propia antes del comando.
BOOTSTRAP_ACADEMY=
BOOTSTRAP_ACADEMY_NAME=
BOOTSTRAP_USERNAME=
BOOTSTRAP_NAME=
BOOTSTRAP_PASSWORD=
# Clave privada: se genera en .env.keys con npm run keys:generate; no publicar.

# Origen exacto del navegador; en produccion usar el HTTPS publico, sin ruta ni slash final.
WEB_ORIGIN=http://127.0.0.1:3000

# Herramientas PostgreSQL para backup. Ruta a pg_dump/pg_restore compatible con servidor.
PG_BIN=
# Opcional: carpeta privada; predeterminado .backups (excluida de Git).
BACKUP_DIRECTORY=
# La clave se genera en .env.backup, nunca publicarla ni guardarla con las copias.

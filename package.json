{
  "name": "piscina",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.13.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.3.0",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --env-file-if-exists=.env.keys --import tsx --watch apps/api/src/main.ts",
    "dev:web": "node --env-file-if-exists=.env node_modules/next/dist/bin/next dev apps/web --hostname 127.0.0.1",
    "dev:mobile": "npm run start --workspace @piscina/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint apps scripts contracts",
    "test": "node --import tsx --test apps/api/test/*.test.ts apps/mobile/test/*.test.ts",
    "test:postgres": "node --env-file-if-exists=.env --import tsx --test apps/api/integration/*.test.ts",
    "build": "npm run build --workspace @piscina/api && npm run build --workspace @piscina/web",
    "build:mobile": "npm run bundle:android --workspace @piscina/mobile",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run build:mobile",
    "db:check": "node --env-file-if-exists=.env --import tsx apps/api/src/db-check.ts",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.mjs",
    "preinstall": "node scripts/check-runtime.mjs",
    "start:api": "node --env-file-if-exists=.env --env-file-if-exists=.env.keys apps/api/dist/main.js",
    "start:web": "node --env-file-if-exists=.env node_modules/next/dist/bin/next start apps/web --hostname 127.0.0.1",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.keys --import tsx apps/api/src/access/cli.ts migrate",
    "users:bootstrap": "node --env-file-if-exists=.env --env-file-if-exists=.env.keys --import tsx apps/api/src/access/cli.ts bootstrap",
    "users:recover": "node --env-file-if-exists=.env --env-file-if-exists=.env.keys --import tsx apps/api/src/access/cli.ts recover",
    "db:seed:demo": "node --env-file-if-exists=.env --env-file-if-exists=.env.keys --import tsx apps/api/src/access/demo-cli.ts --demo",
    "keys:generate": "node scripts/generate-access-key.mjs",
    "smoke:access": "node --env-file-if-exists=.env --import tsx scripts/smoke-access.ts",
    "backup:key": "node --import tsx scripts/backup.ts key",
    "backup:create": "node --env-file-if-exists=.env --env-file-if-exists=.env.backup --import tsx scripts/backup.ts create",
    "backup:verify": "node --env-file-if-exists=.env --env-file-if-exists=.env.backup --import tsx scripts/backup.ts verify"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "concurrently": "9.2.5",
    "eslint": "10.13.0",
    "playwright-core": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}

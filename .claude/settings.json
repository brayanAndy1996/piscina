{
  "model": "claude-opus-5-5",
  "effortLevel": "high",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/preparar-sesion.mjs\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
